{
  "name": "codemore-week4-task1-api-rate-limiter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Custom API rate limiting laboratory",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
